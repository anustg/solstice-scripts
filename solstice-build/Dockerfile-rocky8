# SOLSTICE!!!
RUN dnf -y install libyaml-devel
 
ENV VER_SOLSTICE=0.9.1
 
# Combine all RUN commands into one to reduce the number of layers
WORKDIR /home/john
RUN sudo su john -c "git clone https://github.com/arfontalvoANU/solstice.git" && \
    cd /home/john/solstice && \
    sudo su john -c "git checkout dev" && \
    cd /home/john/solstice/cmake && \
    sudo su john -c "cmake -DCMAKE_BUILD_TYPE=$BUILD_TYPE . && make $MAKE_FLAGS" && \
    sudo su john -c "make test" && \
    sudo su john -c "make DESTDIR=/home/john/install install" && \
    make install
 
# CLEAN UP EMBREE BINS
 
RUN rm -rf /home/john/install/usr/local/bin/embree3
 
# TAR UP THE BINARY
FROM rockylinux:8
COPY --from=prereqs /home/john/install /home/john/install
RUN useradd -s /bin/bash -m john
RUN usermod -aG wheel john
RUN echo "john ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
 
WORKDIR /home/john
 
# Rocky8 no usa lsb-release igual que Ubuntu, así que armamos el nombre a mano
ENV VER_SOLSTICE=0.9.1
RUN uname -a && cat /etc/redhat-release && \
    export DISTRO_NAME="rockylinux8" && \
    export DIRNAME="solstice-$VER_SOLSTICE-`uname -p`-$DISTRO_NAME" && \
    echo $DIRNAME && \
    mv install $DIRNAME && \
    tar zcvf $DIRNAME.tar.gz $DIRNAME/*
 
RUN ls
LABEL description="Solstice $VER_SOLSTICE built on Rocky Linux 8 (glibc 2.28)"
